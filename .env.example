# --- Catalog database ---
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=change-me
CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5433

# --- Catalog (Django) ---
DJANGO_SECRET_KEY=pega-aqui-tu-clave
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Auth (JWT) ---
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# --- Booking database ---
BOOKING_DB_NAME=booking
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=change-me
BOOKING_DB_HOST=localhost
BOOKING_DB_PORT=5434

# --- Redis (rate limiting, cache) ---
REDIS_PORT=6379
CATALOG_REDIS_URL=redis://localhost:6379/1
BOOKING_REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ (events between services) ---
RABBITMQ_USER=tickethub
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://tickethub:change-me@localhost:5672/

# --- Email (Mailpit in development: captures, never delivers) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="TicketHub <tickets@tickethub.local>"

# --- Payments (Stripe test mode: put YOUR keys here, never in git or chat) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
BOOKING_PUBLIC_URL=http://localhost:8001
TICKET_SIGNING_KEY=change-me-to-a-long-random-string

# --- Logging: "console" (readable, local) or "json" (containers/production) ---
LOG_FORMAT=console
LOG_LEVEL=INFO
